# Host/public wiring
APP_HOST=127.0.0.1
APP_PORT=11255
FRONTEND_PORT=11255
API_PORT=18080
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=http://api:8080

# Runtime profile (HTTP-only default for VPS bootstrap)
APP_ENV=development
APP_HTTP_ADDR=:8080
APP_LOG_LEVEL=info
APP_LOG_FORMAT=json
APP_CORS_ORIGINS=http://127.0.0.1:11255,http://localhost:11255

# Postgres/Redis
POSTGRES_DB=cloud
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_DATABASE_URL=postgres://postgres:postgres@postgres:5432/cloud?sslmode=disable
APP_REDIS_URL=redis://redis:6379/0

# Storage
APP_STORAGE_LOCAL_ROOT=/app/data/storage

# Security (replace before internet exposure)
APP_MASTER_KEY=replace-with-at-least-32-characters-secret
APP_JWT_SIGNING_KEY=replace-with-at-least-32-characters-jwt-secret
APP_JWT_ISSUER=cloud-api
APP_JWT_AUDIENCE=cloud-web
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=720h
APP_COOKIE_SECURE=false
APP_COOKIE_DOMAIN=
APP_COOKIE_SAMESITE=lax
APP_TRUSTED_PROXY_CIDRS=

# Bootstrap admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=Passw0rd!123
APP_BOOTSTRAP_ADMIN_NAME=Admin
APP_BOOTSTRAP_ADMIN_ROLE=owner
APP_DEFAULT_USER_QUOTA_BYTES=21474836480

# Server tuning
APP_SHUTDOWN_TIMEOUT=15s
APP_AUTH_RATE_LIMIT=10
APP_AUTH_RATE_WINDOW=1m

# Upload tuning
APP_UPLOAD_SESSION_TTL=24h
APP_UPLOAD_MAX_CHUNK_BYTES=16777216
APP_UPLOAD_MAX_FILE_BYTES=107374182400
APP_UPLOAD_MAX_ACTIVE_SESSIONS=64
APP_UPLOAD_MAX_STAGED_BYTES=214748364800
APP_UPLOAD_REAPER_INTERVAL=1m
APP_UPLOAD_REAPER_BATCH_SIZE=200
